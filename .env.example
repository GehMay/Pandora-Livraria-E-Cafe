# Copie este arquivo para .env e preencha com a connection string real
# (Supabase → Connect → Connection string → aba "Session pooler").
# Não use a connection string de "Direct connection": ela é IPv6-only e não
# funciona no Render nem em redes sem suporte a IPv6.
DATABASE_URL=postgresql://postgres.<ref-do-projeto>:<senha-do-banco>@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Chave usada para assinar os tokens de sessão (login). Gere uma string
# aleatória longa, por exemplo com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Sem essa variável o servidor funciona (usa uma chave fixa só de desenvolvimento),
# mas em produção ela é obrigatória — trocar essa chave invalida todas as sessões ativas.
SESSION_SECRET=<gere-uma-chave-aleatoria-longa>
