# Copie este arquivo para ".env" e preencha para ativar o MySQL.
# Sem essas variáveis, o site continua funcionando normalmente
# usando dados/*.json. Veja database/MYSQL.md para mais detalhes.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pandora_livraria

# Alternativa: uma única URL de conexão (se o seu provedor fornecer uma).
# Se definida, tem prioridade sobre as variáveis MYSQL_* acima.
# DATABASE_URL=mysql://usuario:senha@host:3306/pandora_livraria
